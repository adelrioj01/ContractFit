POSTGRES_DB=contractfit
POSTGRES_USER=contractfit
POSTGRES_PASSWORD=contractfit
DATABASE_URL=postgresql+psycopg://contractfit:contractfit@postgres:5432/contractfit
REDIS_URL=redis://redis:6379/0
APP_ENV=development
LOG_LEVEL=INFO
AI_PROVIDER=offline
OLLAMA_BASE_URL=http://host.docker.internal:11434
